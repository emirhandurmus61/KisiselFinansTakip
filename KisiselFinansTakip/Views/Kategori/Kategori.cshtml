@model KisiselFinansTakip.Models.ViewModels.KategoriViewModel

@{
    ViewData["Title"] = "Kategori Yönetimi";
    bool guncellemeModu = Model.KategoriID > 0;
    int toplamKategori = Model.Kategoriler?.Count ?? 0;
    int gelirKategoriSayisi = Model.Kategoriler?.Count(k => k.Tip == "Gelir") ?? 0;
    int giderKategoriSayisi = Model.Kategoriler?.Count(k => k.Tip == "Gider") ?? 0;
}

<div class="row page-titles mx-0 align-items-center">
    <div class="col-sm-6 p-md-0">
        <div class="welcome-text">
            <h4 class="font-weight-bold text-primary">Kategori Yönetimi</h4>
            <p class="mb-0 text-muted">Gelir ve gider işlemlerinizi sınıflandırmak için kategorilerinizi düzenleyin</p>
        </div>
    </div>
    <div class="col-sm-6 p-md-0 justify-content-sm-end mt-2 mt-sm-0 d-flex">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Default" asp-action="Index">Ana Panel</a></li>
            <li class="breadcrumb-item active">Kategoriler</li>
        </ol>
    </div>
</div>

@if (TempData["Mesaj"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fa fa-check-circle mr-1"></i> @TempData["Mesaj"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@if (TempData["Uyari"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show shadow-sm" role="alert">
        <i class="fa fa-exclamation-circle mr-1"></i> @TempData["Uyari"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<!-- Üst Özet Sayaçlar -->
<div class="row mb-3">
    <div class="col-md-4">
        <div class="card shadow-sm border-0 bg-primary text-white">
            <div class="card-body py-3 d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-white-50 mb-1">Toplam Kategori</h6>
                    <h3 class="text-white font-weight-bold mb-0">@toplamKategori</h3>
                </div>
                <i class="fa fa-tags fa-2x text-white-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 bg-success text-white">
            <div class="card-body py-3 d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-white-50 mb-1">Gelir Kategorileri</h6>
                    <h3 class="text-white font-weight-bold mb-0">@gelirKategoriSayisi</h3>
                </div>
                <i class="fa fa-arrow-down fa-2x text-white-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 bg-danger text-white">
            <div class="card-body py-3 d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-white-50 mb-1">Gider Kategorileri</h6>
                    <h3 class="text-white font-weight-bold mb-0">@giderKategoriSayisi</h3>
                </div>
                <i class="fa fa-arrow-up fa-2x text-white-50"></i>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Sol: Kategori Formu -->
    <div class="col-xl-4 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-header border-bottom">
                <h5 class="card-title font-weight-bold text-dark m-0">
                    <i class="fa @(guncellemeModu ? "fa-edit text-warning" : "fa-plus-circle text-primary") mr-2"></i>
                    @(guncellemeModu ? "Kategoriyi Güncelle" : "Yeni Kategori Ekle")
                </h5>
            </div>
            <div class="card-body">
                <form asp-action="KategoriIslem" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="KategoriID" />

                    <div class="form-group">
                        <label class="font-weight-bold">Kategori Adı</label>
                        <input type="text" asp-for="KategoriAdi" class="form-control" placeholder="Örn: Market, Maaş, Kira..." required />
                        <span asp-validation-for="KategoriAdi" class="text-danger small"></span>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold">İşlem Türü</label>
                        <select asp-for="Tip" class="form-control" required>
                            <option value="">Tür Seçiniz...</option>
                            <option value="Gelir">Gelir</option>
                            <option value="Gider">Gider</option>
                        </select>
                        <span asp-validation-for="Tip" class="text-danger small"></span>
                    </div>

                    <div class="mt-4">
                        @if (guncellemeModu)
                        {
                            <button type="submit" name="action" value="Guncelle" class="btn btn-warning btn-block font-weight-bold text-white shadow-sm">
                                <i class="fa fa-check mr-1"></i> Değişiklikleri Kaydet
                            </button>
                            <a asp-action="Kategori" class="btn btn-outline-secondary btn-block mt-2">
                                İptal Et
                            </a>
                        }
                        else
                        {
                            <button type="submit" name="action" value="Ekle" class="btn btn-primary btn-block font-weight-bold shadow-sm">
                                <i class="fa fa-plus mr-1"></i> Kategoriyi Kaydet
                            </button>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Sağ: Kategori Listesi -->
    <div class="col-xl-8 col-lg-7">
        <div class="card shadow-sm">
            <div class="card-header border-bottom d-flex justify-content-between align-items-center">
                <h5 class="card-title font-weight-bold text-dark m-0">
                    <i class="fa fa-list text-primary mr-2"></i> Mevcut Kategoriler (@toplamKategori)
                </h5>
            </div>
            <div class="card-body">
                @if (Model.Kategoriler != null && Model.Kategoriler.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="thead-light">
                                <tr>
                                    <th style="width: 80px;">#ID</th>
                                    <th>Kategori Adı</th>
                                    <th>Tür</th>
                                    <th class="text-right" style="width: 160px;">İşlemler</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Kategoriler)
                                {
                                    bool isGelir = item.Tip == "Gelir";
                                    <tr>
                                        <td class="font-weight-bold text-muted">#@item.KategoriID</td>
                                        <td class="font-weight-bold text-dark">@item.KategoriAdi</td>
                                        <td>
                                            <span class="badge @(isGelir ? "badge-success" : "badge-danger") px-3 py-1 font-weight-bold">
                                                <i class="fa @(isGelir ? "fa-arrow-down" : "fa-arrow-up") mr-1"></i>
                                                @item.Tip
                                            </span>
                                        </td>
                                        <td class="text-right">
                                            <a asp-action="KategoriGetir" asp-route-id="@item.KategoriID" class="btn btn-sm btn-outline-warning mr-1 shadow-sm" title="Düzenle">
                                                <i class="fa fa-edit"></i>
                                            </a>
                                            <form asp-action="KategoriIslem" method="post" class="d-inline" onsubmit="return confirm('Bu kategoriyi silmek istediğinizden emin misiniz?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="KategoriID" value="@item.KategoriID" />
                                                <button type="submit" name="action" value="Sil" class="btn btn-sm btn-outline-danger shadow-sm" title="Sil">
                                                    <i class="fa fa-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="fa fa-tags fa-3x mb-3 text-primary"></i>
                        <h5>Henüz hiç kategori tanımlanmamış.</h5>
                        <p>Soldaki formu kullanarak hemen ilk kategorinizi ekleyebilirsiniz.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
