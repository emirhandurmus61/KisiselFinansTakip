        <div class="content-body">
            <div class="container-fluid">
                <div class="row page-titles mx-0">
                    <div class="col-sm-6 p-md-0">
                        <div class="welcome-text">
                            <h4>Hi, welcome back!</h4>
                            <span class="ml-1">Element</span>
                        </div>
                    </div>
                    <div class="col-sm-6 p-md-0 justify-content-sm-end mt-2 mt-sm-0 d-flex">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="javascript:void(0)">Form</a></li>
                            <li class="breadcrumb-item active"><a href="javascript:void(0)">Element</a></li>
                        </ol>
                    </div>
                </div>
                <!-- row -->
                <div class="row">
                    <div class="col-xl-6 col-xxl-12">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">Kategori Düzenle</h4>
                            </div>
                            @if (TempData["Uyari"] != null)
                            {
                                <div class="alert alert-warning solid alert-right-icon alert-dismissible fade show mx-2 mb-0">
                                    <span><i class="mdi mdi-alert"></i></span>
                                    <button type="button" class="close h-100" data-dismiss="alert" aria-label="Close">
                                        <span><i class="mdi mdi-close"></i></span>
                                    </button>
                                    <strong>Uyarı!</strong> @TempData["Uyari"]
                                </div>
                            }

                            @if (TempData["Mesaj"] != null)
                            {
                                <div class="alert alert-success solid alert-right-icon alert-dismissible fade show mx-2 mb-0">
                                    <span><i class="mdi mdi-check-circle"></i></span>
                                    <button type="button" class="close h-100" data-dismiss="alert" aria-label="Close">
                                        <span><i class="mdi mdi-close"></i></span>
                                    </button>
                                    <strong>Başarılı!</strong> @TempData["Mesaj"]
                                </div>
                            }



                            @using (Html.BeginForm("KategoriIslem", "Kategori", FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                @Html.HiddenFor(m => m.KategoriID)  <!-- Gizli ID alanı eklenmeli -->

                                <div class="card-body">
                                    <div class="basic-form">

                                        <div class="form-group">
                                            <label><strong>Kategori Adı</strong></label>
                                            @Html.TextBoxFor(m => m.KategoriAdi, new { @class = "form-control", type = "text" })
                                            @Html.ValidationMessageFor(m => m.KategoriAdi, "", new { @class = "text-danger" })
                                        </div>

                                        @Html.DropDownListFor(m => m.Tip,
                                    new SelectList(Model.TipListesi),
                                    "Seçiniz",
                                    new { @class = "form-control" })

                                        <div class="row">

                                            <div class="col-4">
                                                <button type="submit" class="btn btn-primary btn-block m-2" name="action" value="Ekle">
                                                    <i class="fa-solid fa-plus"></i> Ekle
                                                </button>
                                            </div>

                                            <div class="col-4">
                                                <button type="submit" class="btn btn-success btn-block m-2" name="action" value="Guncelle">
                                                    <i class="fa-solid fa-wrench"></i> Güncelle
                                                </button>
                                            </div>

                                            <div class="col-4">
                                                <button type="submit" class="btn btn-danger btn-block m-2" name="action" value="Sil"
                                                        onclick="return confirm('Silmek istediğinize emin misiniz?');">
                                                    <i class="fa-solid fa-trash"></i> Sil
                                                </button>
                                            </div>

                                        </div>

                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="col-lg-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">Kategoriler</h4>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-striped table-responsive-sm">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Kategori Adı</th>
                                            <th>Tip</th>
                                            <th>İşlemler</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.Kategoriler != null)
                                        {
                                            int i = 1;
                                            foreach (var item in Model.Kategoriler)
                                            {
                                                <tr>
                                                    <th>@i</th>
                                                    <td>@item.KategoriAdi</td>
                                                    <td>
                                                        @if (item.Tip == "Gelir")
                                                        {
                                                            <span class="badge badge-success">Gelir</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge badge-danger">Gider</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <a href="@Url.Action("KategoriGetir", "Kategori", new { id = item.KategoriID })"
                                                           class="btn btn-warning btn-block m-2">
                                                            <i class="fa-solid fa-eye"></i> Getir
                                                        </a>
                                                    </td>
                                                </tr>
                                                i++;
                                            }
                                        }
                                        else
                                        {
                                            <tr><td colspan="4">Hiç kategori bulunamadı.</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>





