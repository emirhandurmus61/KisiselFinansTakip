@model KisiselFinansTakip.Models.ViewModels.RegisterViewModel

@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" class="h-100">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Focus - Finans Takip Admin Paneli </title>
    <!-- Favicon icon -->
    <link rel="icon" type="image/png" sizes="16x16" href="~/focus-2/images/favicon.png">
    <link href="~/focus-2/css/style.css" rel="stylesheet">

</head>

<body class="h-100">
    <div class="authincation h-100">
        <div class="container-fluid h-100">
            <div class="row justify-content-center h-100 align-items-center">
                <div class="col-md-6">
                    <div class="authincation-content">
                        <div class="row no-gutters">
                            <div class="col-xl-12">
                                <div class="auth-form">
                                    <h4 class="text-center mb-4">Hesabınızı Kaydedin</h4>
                                    @using (Html.BeginForm("Register", "Account", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                            <div class="form-group">
                                                <label><strong>Ad</strong></label>
                                                @Html.TextBoxFor(m => m.Ad, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(m => m.Ad, "", new { @class = "text-danger" })

                                            </div>
                                            <div class="form-group">
                                                <label><strong>Soyad</strong></label>
                                                @Html.TextBoxFor(m => m.Soyad, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(m => m.Soyad, "", new { @class = "text-danger" })

                                            </div>
                                            <div class="form-group">
                                                <label><strong>Email</strong></label>
                                                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email" })
                                                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                                            </div>
                                            <div class="form-group">
                                                <label><strong>Şifre</strong></label>
                                                @Html.PasswordFor(m => m.Sifre, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(m => m.Sifre, "", new { @class = "text-danger" })
                                            </div>
                                            <div class="text-center mt-4">
                                                <button type="submit" class="btn btn-primary btn-block">Beni Kaydet</button>
                                            </div>
                                    }
                                    <div class="new-account mt-3">
                                        <p>
                                            Zaten bir hesabınız var mı? <a class="text-primary" asp-controller="Account" asp-action="Login">Giriş Yap</a>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!--**********************************
        Scripts
    ***********************************-->
    <!-- Required vendors -->
    <script src="~/focus-2/vendor/global/global.min.js"></script>
    <script src="~/focus-2/js/quixnav-init.js"></script>
    <!--endRemoveIf(production)-->
</body>

</html>