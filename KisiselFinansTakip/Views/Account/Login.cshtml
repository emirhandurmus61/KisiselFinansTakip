@model KisiselFinansTakip.Models.ViewModels.LoginViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr" class="h-100">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Giriş Yap - Kişisel Finans Takip</title>
    <link rel="icon" type="image/png" sizes="16x16" href="~/focus-2/images/favicon.png">
    <link href="~/focus-2/css/style.css" rel="stylesheet">
</head>

<body class="h-100">
    <div class="authincation h-100">
        <div class="container-fluid h-100">
            <div class="row justify-content-center h-100 align-items-center">
                <div class="col-md-5">
                    <div class="authincation-content">
                        <div class="row no-gutters">
                            <div class="col-xl-12">
                                <div class="auth-form">
                                    <div class="text-center mb-4">
                                        <h3 class="text-primary font-weight-bold">💰 FinansTakip</h3>
                                        <p class="text-muted">Kişisel Gelir & Gider Yönetim Paneli</p>
                                    </div>
                                    <h4 class="text-center mb-4">Hesabınıza Giriş Yapın</h4>

                                    @if (TempData["BasariMesaji"] != null)
                                    {
                                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                                            <i class="fa fa-check-circle mr-1"></i> @TempData["BasariMesaji"]
                                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                                <span aria-hidden="true">&times;</span>
                                            </button>
                                        </div>
                                    }

                                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""] != null && ViewData.ModelState[""].Errors.Count > 0)
                                    {
                                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                            <i class="fa fa-exclamation-triangle mr-1"></i>
                                            @foreach (var error in ViewData.ModelState[""].Errors)
                                            {
                                                <span>@error.ErrorMessage</span><br />
                                            }
                                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                                <span aria-hidden="true">&times;</span>
                                            </button>
                                        </div>
                                    }

                                    @using (Html.BeginForm("Login", "Account", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        <div class="form-group">
                                            <label><strong>E-posta Adresi</strong></label>
                                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", placeholder = "ornek@email.com", required = "required" })
                                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                                        </div>
                                        <div class="form-group">
                                            <label><strong>Şifre</strong></label>
                                            @Html.PasswordFor(m => m.Sifre, new { @class = "form-control", placeholder = "••••••••", required = "required" })
                                            @Html.ValidationMessageFor(m => m.Sifre, "", new { @class = "text-danger small" })
                                        </div>
                                        <div class="text-center mt-4">
                                            <button type="submit" class="btn btn-primary btn-block font-weight-bold">Giriş Yap</button>
                                        </div>
                                    }
                                    <div class="new-account mt-4 text-center">
                                        <p>Hesabınız yok mu? <a class="text-primary font-weight-bold" asp-controller="Account" asp-action="Register">Hemen Kayıt Olun</a></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/focus-2/vendor/global/global.min.js"></script>
    <script src="~/focus-2/js/quixnav-init.js"></script>
    <script src="~/focus-2/js/custom.min.js"></script>
</body>
</html>
