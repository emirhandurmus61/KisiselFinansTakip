@model KisiselFinansTakip.Models.Siniflar.Kullanici

@{
    ViewData["Title"] = "Profilim";
}

<div class="row page-titles mx-0 align-items-center">
    <div class="col-sm-6 p-md-0">
        <div class="welcome-text">
            <h4 class="font-weight-bold text-primary">Hesap Bilgilerim</h4>
            <p class="mb-0 text-muted">Profil detaylarınızı görüntüleyin ve güncelleyin</p>
        </div>
    </div>
    <div class="col-sm-6 p-md-0 justify-content-sm-end mt-2 mt-sm-0 d-flex">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Default" asp-action="Index">Ana Panel</a></li>
            <li class="breadcrumb-item active">Profil</li>
        </ol>
    </div>
</div>

@if (TempData["Mesaj"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fa fa-check-circle mr-1"></i> @TempData["Mesaj"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@if (TempData["Hata"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="fa fa-exclamation-triangle mr-1"></i> @TempData["Hata"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<div class="row">
    <!-- Sol: Profil Kartı -->
    <div class="col-xl-4 col-lg-5">
        <div class="card shadow-sm text-center">
            <div class="card-body">
                <div class="profile-photo my-3">
                    <div class="rounded-circle bg-primary text-white d-inline-flex justify-content-center align-items-center shadow" style="width: 100px; height: 100px; font-size: 38px;">
                        @(Model.Ad?.Substring(0, 1).ToUpper() ?? "U")@(Model.Soyad?.Substring(0, 1).ToUpper() ?? "")
                    </div>
                </div>
                <h4 class="mt-3 mb-1 font-weight-bold text-dark">@Model.Ad @Model.Soyad</h4>
                <p class="text-muted">@Model.Email</p>
                <div class="border-top pt-3 mt-3 text-left">
                    <p class="mb-1 text-muted"><i class="fa fa-shield-alt text-primary mr-2"></i> Rol: <strong class="text-dark">@Model.Rol</strong></p>
                    <p class="mb-0 text-muted"><i class="fa fa-calendar-check text-success mr-2"></i> Kayıt Tarihi: <strong class="text-dark">@Model.KayitTarihi.ToString("dd.MM.yyyy")</strong></p>
                </div>
            </div>
        </div>
    </div>

    <!-- Sağ: Bilgileri Güncelleme Formu -->
    <div class="col-xl-8 col-lg-7">
        <div class="card shadow-sm">
            <div class="card-header border-bottom">
                <h5 class="card-title font-weight-bold text-dark m-0">
                    <i class="fa fa-user-edit text-primary mr-2"></i> Profil Bilgilerini Güncelle
                </h5>
            </div>
            <div class="card-body">
                <form asp-action="ProfilGuncelle" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="KullaniciID" />
                    <input type="hidden" asp-for="Rol" />

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label class="font-weight-bold">Ad</label>
                            <input type="text" asp-for="Ad" class="form-control" required />
                        </div>
                        <div class="form-group col-md-6">
                            <label class="font-weight-bold">Soyad</label>
                            <input type="text" asp-for="Soyad" class="form-control" required />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold">E-posta Adresi</label>
                        <input type="email" asp-for="Email" class="form-control" required />
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold">Değişiklikleri Kaydetmek İçin Mevcut Şifreniz</label>
                        <input type="password" name="Sifre" class="form-control" placeholder="••••••••" required />
                        <small class="form-text text-muted">Güvenliğiniz için değişiklikleri kaydederken mevcut şifrenizi girmelisiniz.</small>
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary font-weight-bold shadow-sm px-4">
                            <i class="fa fa-save mr-1"></i> Bilgileri Güncelle
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
