@{
    var kullaniciAdi = Context.Session.GetString("KullaniciAdi") ?? "Kullanıcı";
    var email = Context.Session.GetString("Email") ?? "";
    var turkceKultur = new System.Globalization.CultureInfo("tr-TR");
}

<div class="header">
    <div class="header-content">
        <nav class="navbar navbar-expand">
            <div class="collapse navbar-collapse justify-content-between">
                <div class="header-left">
                    <span class="badge badge-primary px-3 py-2 font-weight-bold" style="font-size: 13px;">
                        <i class="fa fa-calendar-alt mr-1"></i> @DateTime.Now.ToString("dd MMMM yyyy, dddd", turkceKultur)
                    </span>
                </div>

                <ul class="navbar-nav header-right">
                    <li class="nav-item dropdown header-profile">
                        <a class="nav-link d-flex align-items-center" href="#" role="button" data-toggle="dropdown">
                            <i class="fa fa-user-circle text-primary" style="font-size: 26px;"></i>
                            <span class="ml-2 font-weight-bold text-dark d-none d-md-inline">@kullaniciAdi</span>
                            <i class="fa fa-angle-down ml-1 text-muted"></i>
                        </a>
                        <div class="dropdown-menu dropdown-menu-right shadow">
                            <div class="dropdown-header text-center border-bottom pb-2 mb-2">
                                <strong class="d-block text-dark">@kullaniciAdi</strong>
                                <small class="text-muted">@email</small>
                            </div>
                            <a asp-controller="Profile" asp-action="Profile" class="dropdown-item">
                                <i class="fa fa-user text-primary mr-2"></i> Profilim
                            </a>
                            <a asp-controller="Islemlerim" asp-action="Islemler" class="dropdown-item">
                                <i class="fa fa-exchange-alt text-info mr-2"></i> Hareketlerim
                            </a>
                            <a asp-controller="ButceHedeflerim" asp-action="ButceHedeflerim" class="dropdown-item">
                                <i class="fa fa-bullseye text-warning mr-2"></i> Bütçe Hedeflerim
                            </a>
                            <div class="dropdown-divider"></div>
                            <a asp-controller="Account" asp-action="Logout" class="dropdown-item text-danger">
                                <i class="fa fa-sign-out-alt text-danger mr-2"></i> Çıkış Yap
                            </a>
                        </div>
                    </li>
                </ul>
            </div>
        </nav>
    </div>
</div>
